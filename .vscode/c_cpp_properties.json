{
    "configurations": [
        {
            "name": "Linux CUDA 12.9 / SM89",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/third_party/vllm_marlin/minivllm/csrc",
                "${workspaceFolder}/third_party/vllm_marlin/minivllm/csrc/quantization/marlin",
                "${workspaceFolder}/third_party/vllm_marlin/generated/sm89_w4a16",
                "${workspaceFolder}/../cuda-12.9/include",
                "${workspaceFolder}/../cuda-12.9/targets/x86_64-linux/include",
                "${workspaceFolder}/../vllm-from-scratch/.venv/lib/python3.12/site-packages/torch/include",
                "${workspaceFolder}/../vllm-from-scratch/.venv/lib/python3.12/site-packages/torch/include/torch/csrc/api/include",
                "${workspaceFolder}/../vllm-from-scratch/.venv/lib/python3.12/site-packages/nvidia/cublas/include"
            ],
            "defines": [
                "USE_CUDA",
                "TORCH_TARGET_VERSION=0x020B000000000000ULL"
            ],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64"
        }
